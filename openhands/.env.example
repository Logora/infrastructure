# ===== LLM (OpenRouter) =====
# Get an API key from https://openrouter.ai/keys
LLM_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=openrouter/anthropic/claude-opus-5
LLM_BASE_URL=https://openrouter.ai/api/v1

# ===== GitHub OAuth App (for oauth2-proxy) =====
# Create a GitHub OAuth App:
#   Settings -> Developer settings -> OAuth Apps -> New OAuth App
#   - Homepage URL: https://agent.logora.com
#   - Authorization callback URL: https://agent.logora.com/oauth2/callback
# Restrict access to members of the "Logora" org (handled by --github-org).
OAUTH2_PROXY_CLIENT_ID=your-github-oauth-client-id
OAUTH2_PROXY_CLIENT_SECRET=your-github-oauth-client-secret

# Random 32-byte secret used to sign auth cookies.
# Generate with:  openssl rand -base64 32
OAUTH2_PROXY_COOKIE_SECRET=replace-with-a-random-32-byte-secret

# ===== Slack (Socket Mode stream, Agent Canvas >= 1.17.0) =====
# Push events from Slack into the automation service (self-hosted equivalent
# of webhooks). See openhands/README.md "Slack (Socket Mode)" section.
# Fields: org_id is the deterministic self-hosted org UUID (fixed value below);
# app_token = App-Level token (xapp-1-, scope connections:write);
# bot_token = Bot User OAuth Token (xoxb-); team_id / bot_user_id from
#   curl -s -X POST -H "Authorization: Bearer xoxb-..." https://slack.com/api/auth.test
# The Slack app must have: Socket Mode enabled, bot event subscription
# "app_mention", bot scopes (app_mentions:read, channels:history, chat:write, ...).
# Stored as a Kubernetes Secret (openhands-slack) — never commit real tokens.
AUTOMATION_SLACK_APPS=[{"org_id":"46d09c5c-7d7d-585f-8c37-a6b45a3de738","app_token":"xapp-1-your-app-token","bot_token":"xoxb-your-bot-token","team_id":"T0123456789","bot_user_id":"U0123456789"}]
