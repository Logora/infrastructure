# ===== Directus core =====
# Generate strong random values: `openssl rand -hex 32`
KEY=replace_with_your_key
SECRET=replace_with_your_secret_key

# Public URL of the instance (must match the ingress host)
PUBLIC_URL=https://directus.example.com

# ===== Database (PostgreSQL) =====
# IMPORTANT: use INDIVIDUAL DB_* variables, NOT DB_CONNECTION_STRING.
# Directus builds `connection: connectionString || connectionConfig`, so when
# DB_CONNECTION_STRING is set, DB_SSL is IGNORED (TLS verification cannot be
# disabled) — this breaks connections to OVH-managed Postgres (self-signed CA).
DB_CLIENT=pg
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_DATABASE=your-db-name

# Schema to use. Point Directus at the schema that holds the collections you
# want to manage (e.g. `public`, or the app's schema). This is the Knex
# top-level `searchPath`, independent of the connection.
DB_SEARCH_PATH=public

# Disable TLS certificate verification (OVH self-signed CA). Needed unless
# you provide a trusted CA via DB_SSL__CA.
DB_SSL={"rejectUnauthorized":false}

# ===== First admin (used only on first bootstrap) =====
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-after-first-login

# ===== Email / SMTP =====
EMAIL_FROM=no-reply@example.com
EMAIL_SES_REGION=eu-west-3
EMAIL_SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=your-smtp-user
EMAIL_SMTP_PASSWORD=your-smtp-password
EMAIL_TRANSPORT=smtp
# When true, the first admin must confirm their email before the instance is usable.
EMAIL_VERIFY_SETUP=true
